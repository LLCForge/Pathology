{
    "##": "Scoop manifest for Pathology. @VERSION@ and @SHA256_*@ are filled in by the release workflow; checkver/autoupdate keep it current afterwards.",
    "version": "@VERSION@",
    "description": "BGP route monitor for your own routers: BMP and passive BGP collector, learned baselines, deviation alerts",
    "homepage": "https://github.com/LLCForge/Pathology",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/LLCForge/Pathology/releases/download/v@VERSION@/pathology-@VERSION@-x86_64-pc-windows-msvc.zip",
            "hash": "@SHA256_X86_64_WINDOWS@"
        },
        "arm64": {
            "url": "https://github.com/LLCForge/Pathology/releases/download/v@VERSION@/pathology-@VERSION@-aarch64-pc-windows-msvc.zip",
            "hash": "@SHA256_AARCH64_WINDOWS@"
        }
    },
    "bin": "pathology.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/LLCForge/Pathology/releases/download/v$version/pathology-$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/LLCForge/Pathology/releases/download/v$version/pathology-$version-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "regex": "$sha256\\s+$basename"
        }
    }
}
